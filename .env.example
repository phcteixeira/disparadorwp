# Conexão com o banco Neon (Vercel > Storage > Neon integration preenche isso automaticamente)
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon Auth (Managed Better Auth) — pegue em Neon Console > Auth > Configuration
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth"
# gerar com: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# Chave para criptografar credenciais dos plugins de WhatsApp (AES-256-GCM). Gerar com: openssl rand -base64 32
CONNECTION_SECRET_KEY=""

# Protege a rota /api/cron/dispatch-campaigns — a Vercel envia este valor automaticamente
# no header Authorization quando CRON_SECRET está definido nas env vars do projeto.
CRON_SECRET=""

# URL pública da aplicação (usada para montar a URL de webhook mostrada na tela de conexão)
APP_BASE_URL="http://localhost:3000"
